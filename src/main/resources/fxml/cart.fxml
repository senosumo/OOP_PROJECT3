<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.greengrocer.controller.CartController"
            stylesheets="@../styles.css">
    
    <top>
        <Label text="Your Shopping Cart" styleClass="title-label" BorderPane.alignment="CENTER">
            <padding><Insets top="10" bottom="10"/></padding>
        </Label>
    </top>
    
    <center>
        <TableView fx:id="cartTable" style="-fx-max-width: 550;">
            <columns>
                <TableColumn fx:id="itemCol" text="Product" prefWidth="200"/>
                <TableColumn fx:id="quantityCol" text="Quantity" prefWidth="100"/>
                <TableColumn fx:id="priceCol" text="Price/kg" prefWidth="100"/>
                <TableColumn fx:id="totalCol" text="Total" prefWidth="100"/>
            </columns>
        </TableView>
    </center>
    
    <bottom>
        <VBox spacing="10" alignment="CENTER" style="-fx-padding: 20;">
            <Label fx:id="totalLabel" text="Total (inc. VAT): $0.00" styleClass="header-label"/>
            
            <HBox spacing="10" alignment="CENTER">
                <Label text="Delivery Date:"/>
                <DatePicker fx:id="deliveryDate"/>
                <Label text="Time (HH:mm):"/>
                <TextField fx:id="deliveryTimeField" prefWidth="80" promptText="14:00"/>
            </HBox>
            
            <HBox spacing="20" alignment="CENTER">
                <Button text="Remove Selected" style="-fx-background-color: #e74c3c;" onAction="#removeItem"/>
                <Button text="Checkout" style="-fx-background-color: #27ae60;" onAction="#handleCheckout"/>
            </HBox>
        </VBox>
    </bottom>
</BorderPane>
