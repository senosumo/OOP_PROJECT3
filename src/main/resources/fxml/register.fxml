<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.StackPane?>

<StackPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.greengrocer.controller.RegisterController"
           stylesheets="@../styles.css">
    
    <VBox alignment="CENTER" spacing="15" maxWidth="450" maxHeight="500" styleClass="glass-pane">
        <padding>
            <Insets top="30" right="40" bottom="30" left="40"/>
        </padding>

        <Label text="Register Customer" styleClass="header-label"/>
        
        <VBox spacing="5" alignment="CENTER_LEFT">
            <Label text="Username"/>
            <TextField fx:id="usernameField" promptText="Choose a username"/>
        </VBox>
        
        <VBox spacing="5" alignment="CENTER_LEFT">
            <Label text="Password"/>
            <PasswordField fx:id="passwordField" promptText="Choose a password"/>
        </VBox>

        <VBox spacing="5" alignment="CENTER_LEFT">
            <Label text="Address"/>
            <TextField fx:id="addressField" promptText="Delivery Address"/>
        </VBox>
        
        <VBox spacing="5" alignment="CENTER_LEFT">
            <Label text="Phone"/>
            <TextField fx:id="phoneField" promptText="Contact Number"/>
        </VBox>
        
        <Button text="Register" maxWidth="Infinity" onAction="#handleRegister"/>
        
        <Button text="Back to Login" styleClass="secondary-button" onAction="#goBack"/>
    </VBox>
</StackPane>
