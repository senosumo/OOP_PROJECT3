<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.greengrocer.controller.CustomerController"
            stylesheets="@../styles.css" prefWidth="960" prefHeight="540">
    
    <top>
        <HBox spacing="20" alignment="CENTER_LEFT" style="-fx-padding: 10; -fx-background-color: rgba(0,0,0,0.5);">
            <Label fx:id="welcomeLabel" text="Welcome, Customer" styleClass="header-label"/>
            <Region HBox.hgrow="ALWAYS"/>
            <TextField fx:id="searchField" promptText="Search products..." onAction="#handleSearch"/>
            <Button text="Search" onAction="#handleSearch"/>
            <Button text="My Cart" style="-fx-background-color: #f39c12;" onAction="#openCart"/>
            <Button text="Logout" style="-fx-background-color: #e74c3c;" onAction="#handleLogout"/>
        </HBox>
    </top>
    
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;">
            <VBox spacing="15" style="-fx-padding: 20;">
                <TitledPane fx:id="fruitsPane" text="Fruits" expanded="true">
                    <GridPane fx:id="fruitsGrid" hgap="20" vgap="20"/>
                </TitledPane>
                
                <TitledPane fx:id="vegetablesPane" text="Vegetables" expanded="true">
                    <GridPane fx:id="vegetablesGrid" hgap="20" vgap="20"/>
                </TitledPane>
            </VBox>
        </ScrollPane>
    </center>
    
</BorderPane>
