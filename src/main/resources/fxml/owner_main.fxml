<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.greengrocer.controller.OwnerController"
            stylesheets="@../styles.css" prefWidth="960" prefHeight="540">

    <top>
        <HBox spacing="20" alignment="CENTER_LEFT" style="-fx-padding: 10; -fx-background-color: rgba(0,0,0,0.5);">
            <Label text="Owner Dashboard" styleClass="header-label"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Refresh" onAction="#refreshData"/>
            <Button text="Logout" style="-fx-background-color: #e74c3c;" onAction="#handleLogout"/>
        </HBox>
    </top>

    <center>
        <TabPane tabClosingPolicy="UNAVAILABLE">
            <Tab text="Products">
                <VBox spacing="10" style="-fx-padding: 20;">
                    <Label text="Double click Price/Stock/Threshold to Edit. Press Enter to Save." style="-fx-text-fill: #bdc3c7;"/>
                    <TableView fx:id="productTable" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="nameCol" text="Product Name" prefWidth="200"/>
                            <TableColumn fx:id="priceCol" text="Price" prefWidth="100"/>
                            <TableColumn fx:id="stockCol" text="Stock" prefWidth="100"/>
                             <TableColumn fx:id="thresholdCol" text="Threshold" prefWidth="100"/>
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                    </TableView>
                </VBox>
            </Tab>
            
            <Tab text="Orders">
                <VBox spacing="10" style="-fx-padding: 20;">
                    <TableView fx:id="orderTable" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="orderIdCol" text="ID" prefWidth="50"/>
                            <TableColumn fx:id="customerCol" text="Customer ID" prefWidth="100"/>
                            <TableColumn fx:id="statusCol" text="Status" prefWidth="150"/>
                            <TableColumn fx:id="totalCostCol" text="Total Cost" prefWidth="100"/>
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                    </TableView>
                </VBox>
            </Tab>
            
            <Tab text="Reports">
                <VBox spacing="10" style="-fx-padding: 20;" alignment="CENTER">
                    <Label text="Order Status Distribution" style="-fx-font-size: 18px;"/>
                    <javafx.scene.chart.PieChart fx:id="salesChart" title="Orders by Status"/>
                </VBox>
            </Tab>
        </TabPane>
    </center>
    
</BorderPane>
